<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.kodashas</groupId>
  <artifactId>ProCosmeticsEconomyBridge</artifactId>
  <version>1.0.1</version>
  <packaging>jar</packaging>

  <name>ProCosmeticsEconomyBridge</name>
  <description>Charges ProCosmetics purchases against an ExcellentEconomy currency.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <paper.version>26.2.build.123-stable</paper.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>filledev</id>
      <url>https://repo.filledev.se/releases</url>
    </repository>
    <repository>
      <id>nightexpress</id>
      <url>https://repo.nightexpressdev.com/releases</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Paper API: Bukkit, Adventure and MiniMessage. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      ProCosmetics publishes only its API module, and it lags the plugin: 2.0.1 is the newest
      one on the repository while the plugin itself is at 2.0.7. Every type this bridge touches
      has an identical signature in both, so compiling against 2.0.1 is safe; check that again
      before moving to a newer ProCosmetics.
    -->
    <dependency>
      <groupId>se.filledev</groupId>
      <artifactId>procosmetics-api</artifactId>
      <version>2.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>su.nightexpress.excellenteconomy</groupId>
      <artifactId>ExcellentEconomy</artifactId>
      <version>2.8.0</version>
      <scope>provided</scope>
    </dependency>
    <!--
      nightcore is published as a multi-module build and its pom carries no dependencies of its
      own, so the module holding NightPlugin and the placeholder types has to be named directly.
      ExcellentEconomy's own pom lists no dependencies either, hence both are declared here.
    -->
    <dependency>
      <groupId>su.nightexpress.nightcore</groupId>
      <artifactId>main</artifactId>
      <version>2.16.4</version>
      <scope>provided</scope>
    </dependency>
    <!-- Only BooleanIntPair, through the ProCosmetics API. Kept in step with what it compiles against. -->
    <dependency>
      <groupId>it.unimi.dsi</groupId>
      <artifactId>fastutil</artifactId>
      <version>8.5.18</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>
</project>
